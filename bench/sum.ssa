# sum kernel (QBE IL).
# bench(n) = sum_{k=1..n} k*k
# Mirrors bench/sum.c exactly so checksums must match clang -O2.

export
function l $bench(l %n) {
@start
@loop
	%r  =l phi @start 0,     @loop1 %r1
	%k  =l phi @start 1,     @loop1 %k1
	%c  =l cslel %k, %n        # k <= n ?
	jnz %c, @loop1, @end
@loop1
	%kk =l mul %k, %k
	%r1 =l add %r, %kk
	%k1 =l add %k, 1
	jmp @loop
@end
	ret %r
}
